{
  "schema": "strategy-spec/v1",
  "id": "rs_momentum_v5",
  "name": "Relative-Strength Momentum v5 (SL 5%, TP 15%, hold 15)",
  "description": "rs_momentum_v1 with a wider target (15%) and longer hold (15 days) — exit-grid sweep to test if top-decile RS momentum names can sustain a larger move before reverting. SL unchanged at 5%. R:R becomes 3:1.",
  "markets": ["nse"],
  "regimes": ["bull", "sideways"],
  "params": { "proximity": 0.98, "vol_mult": 1.5, "rs_floor": 0.90 },
  "indicators": {
    "hhv200":    { "fn": "hhv", "on": "close",        "window": 200 },
    "vol20":     { "fn": "sma", "on": "total_volume", "window": 20 },
    "del_avg20": { "fn": "sma", "on": "delivery_pct", "window": 20 }
  },
  "entry": {
    "all": [
      "close >= @proximity * hhv200",
      "total_volume > @vol_mult * vol20",
      "delivery_pct > del_avg20",
      "rs_rank >= @rs_floor"
    ]
  },
  "exit": { "stop_loss_pct": 5, "target_pct": 15, "max_hold_days": 15 },
  "provenance": {
    "created": "2026-06-17",
    "hypothesis_id": "h_014",
    "parent_id": "rs_momentum_v1",
    "experiments": []
  }
}
