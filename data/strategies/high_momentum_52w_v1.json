{
  "schema": "strategy-spec/v1",
  "id": "high_momentum_52w_v1",
  "name": "Near-High Momentum v1",
  "description": "Price within 2% of its 200-day high with volume confirmation \u2014 momentum continuation near 52-week-high territory.",
  "markets": [
    "nse"
  ],
  "regimes": [
    "bull"
  ],
  "params": {
    "proximity": 0.98,
    "vol_mult": 1.5
  },
  "indicators": {
    "hhv200": {
      "fn": "hhv",
      "on": "close",
      "window": 200
    },
    "vol20": {
      "fn": "sma",
      "on": "total_volume",
      "window": 20
    }
  },
  "entry": {
    "all": [
      "close >= @proximity * hhv200",
      "total_volume > @vol_mult * vol20"
    ]
  },
  "exit": {
    "stop_loss_pct": 6,
    "target_pct": 12,
    "max_hold_days": 15
  },
  "provenance": {
    "created": "2026-06-12",
    "hypothesis_id": null,
    "parent_id": null,
    "experiments": []
  }
}
