{
  "schema": "strategy-spec/v1",
  "id": "delivery_breakout_v3",
  "name": "Delivery Breakout v3 (double-confirm)",
  "description": "20d breakout requiring BOTH delivery% AND volume above 1.5x their 20d average — institutional accumulation confirmed on two independent axes, intended to halve false breakouts vs v1 (h_013).",
  "markets": ["nse"],
  "regimes": ["bull", "sideways"],
  "params": {
    "del_mult": 1.5,
    "vol_mult": 1.5,
    "lookback": 20
  },
  "indicators": {
    "hhv20": { "fn": "hhv", "on": "close", "window": "@lookback" },
    "hhv20_prev": { "fn": "shift", "on": "hhv20", "n": 1 },
    "del_avg20": { "fn": "sma", "on": "delivery_pct", "window": 20 },
    "vol20": { "fn": "sma", "on": "total_volume", "window": 20 }
  },
  "entry": {
    "all": [
      "close > hhv20_prev",
      "delivery_pct > @del_mult * del_avg20",
      "total_volume > @vol_mult * vol20"
    ]
  },
  "exit": { "stop_loss_pct": 5, "target_pct": 10, "max_hold_days": 10 },
  "param_grid": { "del_mult": [1.3, 1.5, 2.0], "vol_mult": [1.3, 1.5, 2.0] },
  "provenance": {
    "created": "2026-06-16",
    "hypothesis_id": "h_013",
    "parent_id": "delivery_breakout_v1",
    "experiments": []
  }
}
