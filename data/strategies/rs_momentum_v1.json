{
  "schema": "strategy-spec/v1",
  "id": "rs_momentum_v1",
  "name": "Relative-Strength Momentum v1",
  "description": "Near-high momentum (the alpha-positive high_momentum_52w_v2 base) gated to the universe's strongest names by 60-day cross-sectional relative strength. Market-relative by construction — directly targets batch-1's bear-market, long-only failure (h_014).",
  "markets": ["nse"],
  "regimes": ["bull", "sideways"],
  "params": {
    "proximity": 0.98,
    "vol_mult": 1.5,
    "rs_floor": 0.90
  },
  "indicators": {
    "hhv200": { "fn": "hhv", "on": "close", "window": 200 },
    "vol20":  { "fn": "sma", "on": "total_volume", "window": 20 },
    "del_avg20": { "fn": "sma", "on": "delivery_pct", "window": 20 }
  },
  "entry": {
    "all": [
      "close >= @proximity * hhv200",
      "total_volume > @vol_mult * vol20",
      "delivery_pct > del_avg20",
      "rs_rank >= @rs_floor"
    ]
  },
  "exit": { "stop_loss_pct": 5, "target_pct": 10, "max_hold_days": 12 },
  "param_grid": { "rs_floor": [0.80, 0.90, 0.95] },
  "provenance": {
    "created": "2026-06-16",
    "hypothesis_id": "h_014",
    "parent_id": "high_momentum_52w_v2",
    "experiments": []
  }
}
