{
  "schema": "strategy-spec/v1",
  "id": "delivery_breakout_v6",
  "name": "Delivery Breakout v6 (SL 3%, TP 14%)",
  "description": "delivery_breakout_v5 with stop tightened to 3% — one-variable SL sweep. v5 (SL4/TP14) is PF 1.34; question is whether cutting losers 1pt earlier improves expectancy further or removes trades that would have recovered. R:R becomes 4.7:1.",
  "markets": ["nse"],
  "regimes": ["bull", "sideways"],
  "params": { "del_mult": 1.5, "vol_mult": 1.5, "lookback": 20 },
  "indicators": {
    "hhv20":      { "fn": "hhv",   "on": "close",        "window": "@lookback" },
    "hhv20_prev": { "fn": "shift", "on": "hhv20",        "n": 1 },
    "del_avg20":  { "fn": "sma",   "on": "delivery_pct", "window": 20 },
    "vol20":      { "fn": "sma",   "on": "total_volume", "window": 20 }
  },
  "entry": {
    "all": [
      "close > hhv20_prev",
      "delivery_pct > @del_mult * del_avg20",
      "total_volume > @vol_mult * vol20"
    ]
  },
  "exit": { "stop_loss_pct": 3, "target_pct": 14, "max_hold_days": 12 },
  "provenance": {
    "created": "2026-06-17",
    "hypothesis_id": "h_013",
    "parent_id": "delivery_breakout_v5",
    "experiments": []
  }
}
