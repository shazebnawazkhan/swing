{
  "schema": "strategy-spec/v1",
  "id": "delivery_breakout_v1",
  "name": "Delivery Breakout v1",
  "description": "20-day price breakout confirmed by abnormally high delivery percentage (strong hands taking delivery, not intraday churn).",
  "markets": [
    "nse"
  ],
  "regimes": [
    "bull",
    "sideways"
  ],
  "params": {
    "del_mult": 1.5,
    "lookback": 20
  },
  "indicators": {
    "hhv20": {
      "fn": "hhv",
      "on": "close",
      "window": "@lookback"
    },
    "hhv20_prev": {
      "fn": "shift",
      "on": "hhv20",
      "n": 1
    },
    "del_avg20": {
      "fn": "sma",
      "on": "delivery_pct",
      "window": 20
    }
  },
  "entry": {
    "all": [
      "close > hhv20_prev",
      "delivery_pct > @del_mult * del_avg20"
    ]
  },
  "exit": {
    "stop_loss_pct": 5,
    "target_pct": 10,
    "max_hold_days": 10
  },
  "provenance": {
    "created": "2026-06-12",
    "hypothesis_id": null,
    "parent_id": null,
    "experiments": []
  }
}
