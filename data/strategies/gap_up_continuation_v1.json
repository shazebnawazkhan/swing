{
  "schema": "strategy-spec/v1",
  "id": "gap_up_continuation_v1",
  "name": "Gap-Up Continuation v1",
  "description": "Opening gap above the previous high that holds (bullish close) with rising delivery quantity.",
  "markets": [
    "nse"
  ],
  "regimes": [
    "bull",
    "sideways"
  ],
  "params": {},
  "indicators": {
    "high_prev": {
      "fn": "shift",
      "on": "high",
      "n": 1
    },
    "del_prev": {
      "fn": "shift",
      "on": "delivery_qty",
      "n": 1
    }
  },
  "entry": {
    "all": [
      "open > high_prev",
      "close > open",
      "delivery_qty > del_prev"
    ]
  },
  "exit": {
    "stop_loss_pct": 4,
    "target_pct": 8,
    "max_hold_days": 7
  },
  "provenance": {
    "created": "2026-06-12",
    "hypothesis_id": null,
    "parent_id": null,
    "experiments": []
  }
}
