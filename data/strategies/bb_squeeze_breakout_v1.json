{
  "schema": "strategy-spec/v1",
  "id": "bb_squeeze_breakout_v1",
  "name": "BB Squeeze Breakout v1",
  "description": "Bollinger band width near a 60-day low (volatility squeeze), then close above the upper band on elevated volume.",
  "markets": [
    "nse"
  ],
  "regimes": [
    "bull",
    "sideways"
  ],
  "params": {
    "vol_mult": 1.5,
    "squeeze_tol": 1.2
  },
  "indicators": {
    "bbw": {
      "fn": "bb_width",
      "on": "close",
      "window": 20,
      "k": 2
    },
    "bbw_min60": {
      "fn": "llv",
      "on": "bbw",
      "window": 60
    },
    "bbw_prev": {
      "fn": "shift",
      "on": "bbw",
      "n": 1
    },
    "bbw_min_prev": {
      "fn": "shift",
      "on": "bbw_min60",
      "n": 1
    },
    "bb_up": {
      "fn": "bb_upper",
      "on": "close",
      "window": 20,
      "k": 2
    },
    "vol20": {
      "fn": "sma",
      "on": "total_volume",
      "window": 20
    }
  },
  "entry": {
    "all": [
      "bbw_prev <= @squeeze_tol * bbw_min_prev",
      "close > bb_up",
      "total_volume > @vol_mult * vol20"
    ]
  },
  "exit": {
    "stop_loss_pct": 5,
    "target_pct": 12,
    "max_hold_days": 12
  },
  "provenance": {
    "created": "2026-06-12",
    "hypothesis_id": null,
    "parent_id": null,
    "experiments": []
  }
}
