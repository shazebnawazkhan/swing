{
  "schema": "strategy-spec/v1",
  "id": "bb_squeeze_breakout_v3",
  "name": "BB Squeeze Breakout v3 (RSI > 50 momentum gate)",
  "description": "bb_squeeze_breakout_v2 (EMA50-aligned) plus an RSI > 50 condition before the squeeze fires — the momentum oscillator gate from Carter's TTM Squeeze recipe (Mastering the Trade Ch.11, program.md idea #1). Ensures the price is in a positive-momentum regime when the volatility squeeze releases, reducing whipsaws from squeezes that fire into an exhausted move. One-variable add vs v2.",
  "markets": ["nse"],
  "regimes": ["bull", "sideways"],
  "params": { "vol_mult": 1.5, "squeeze_tol": 1.2, "rsi_min": 50 },
  "indicators": {
    "bbw":         { "fn": "bb_width", "on": "close", "window": 20, "k": 2 },
    "bbw_min60":   { "fn": "llv",      "on": "bbw",   "window": 60 },
    "bbw_prev":    { "fn": "shift",    "on": "bbw",   "n": 1 },
    "bbw_min_prev":{ "fn": "shift",    "on": "bbw_min60", "n": 1 },
    "bb_up":       { "fn": "bb_upper", "on": "close", "window": 20, "k": 2 },
    "vol20":       { "fn": "sma",      "on": "total_volume", "window": 20 },
    "ema50":       { "fn": "ema",      "on": "close", "span": 50 },
    "rsi14":       { "fn": "rsi",      "on": "close", "period": 14 }
  },
  "entry": {
    "all": [
      "bbw_prev <= @squeeze_tol * bbw_min_prev",
      "close > bb_up",
      "total_volume > @vol_mult * vol20",
      "close > ema50",
      "rsi14 > @rsi_min"
    ]
  },
  "exit": { "stop_loss_pct": 5, "target_pct": 12, "max_hold_days": 12 },
  "provenance": {
    "created": "2026-06-17",
    "hypothesis_id": null,
    "parent_id": "bb_squeeze_breakout_v2",
    "experiments": []
  }
}
